# ── "Ask my AI" chat assistant (Claude) ──────────────────────────────────────
# From https://console.anthropic.com → API keys. The chat button only appears once this is set
# (it's read at build time, so redeploy after adding it). Set a monthly spend limit in the Console.
ANTHROPIC_API_KEY=
# Best-effort cap on chat messages per server instance per day (default 400).
CHAT_DAILY_LIMIT=

# ── Quote form email (Resend — https://resend.com, free tier is plenty) ──────
# Use the same API key as the AI Social Agent. Without a verified domain Resend can only
# deliver to the address you signed up with, which is where quotes go anyway.
RESEND_API_KEY=
# Where quote requests are delivered (defaults to the email in lib/data.ts).
QUOTE_TO_EMAIL=
# Sender. Leave empty until you verify your own domain in Resend, then set e.g.
# "Kaustubh Chaphekar <hello@yourdomain.com>" — that also turns on the automatic
# "got your request" reply to visitors.
QUOTE_FROM_EMAIL=

# ── SEO ──────────────────────────────────────────────────────────────────────
# Public URL for metadata, sitemap and Open Graph images. Optional on Vercel (the production
# URL is detected automatically) — set it once you add a custom domain.
NEXT_PUBLIC_SITE_URL=
